# Gmail SMTP for RootSystems contact-form delivery.
# Use a Google App Password, never the normal mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=therootsystems.ops@gmail.com
SMTP_APP_PASSWORD=replace-with-16-character-google-app-password

# Where contact messages arrive and which mailbox sends them.
CONTACT_TO_EMAIL=therootsystems.ops@gmail.com
CONTACT_FROM_EMAIL=therootsystems.ops@gmail.com
