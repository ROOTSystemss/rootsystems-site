<!doctype html>
<html lang="en">
<head><%- include("../partials/head") %></head>
<body class="page-status">
  <%- include("../partials/header") %>
  <main class="contact-page">
    <%- include("../partials/page-hero", {
      eyebrow: "Status",
      title: "Is every product <em>answering?</em>",
      lead: "Each product is checked every ~15 minutes from GitHub. Free servers may take up to a minute to wake, so a slow start is shown separately from down.",
      compact: true,
      noVideo: true
    }) %>
    <section class="contact-section" id="status">
      <div class="wrap">
        <% const label = { up: "Up", slow: "Slow start", down: "Down" }; const color = { up: "#127a43", slow: "#a16207", down: "#b42318" }; %>
        <% if (!summary.available) { %>
          <p id="status-no-data"><strong>No check results yet.</strong> The monitor has not recorded a run we can read, so there is nothing to show. We do not fill this page with made-up numbers.</p>
        <% } else { %>
          <p id="status-last-check">Last check: <time datetime="<%= summary.lastCheckAt %>"><%= summary.lastCheckAt.replace("T", " ").slice(0, 16) %> UTC</time> (<%= summary.runs %> recorded runs).</p>
        <% } %>
        <table class="status-table" id="status-table" style="width:100%; border-collapse:collapse; margin-top:12px;">
          <thead><tr><th style="text-align:left; padding:8px 6px;">Product</th><th style="text-align:left; padding:8px 6px;">Now</th><th style="text-align:right; padding:8px 6px;">Last 7 days</th><th style="text-align:right; padding:8px 6px;">Last 90 days</th></tr></thead>
          <tbody>
          <% summary.products.forEach((p) => { %>
            <tr data-product="<%= p.key %>" data-state="<%= p.state || 'no-data' %>" style="border-top:1px solid rgba(127,127,127,.25);">
              <td style="padding:8px 6px;"><%= p.name %></td>
              <td style="padding:8px 6px;"><% if (p.state) { %><strong style="color:<%= color[p.state] %>"><%= label[p.state] %></strong><% if (p.ms != null) { %> <span class="muted">(<%= (p.ms / 1000).toFixed(1) %> s)</span><% } %><% } else { %><span class="muted">No data yet</span><% } %></td>
              <td style="padding:8px 6px; text-align:right;"><%= p.week && p.week.pct != null ? p.week.pct + "%" : "–" %></td>
              <td style="padding:8px 6px; text-align:right;"><%= p.quarter && p.quarter.pct != null ? p.quarter.pct + "%" : "–" %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <p class="rs-note" style="margin-top:14px;">Uptime = checks where the product answered (up or slow start) divided by all its checks in that period. Checks come from GitHub's scheduled runners, which can run late, so there may be fewer than 96 a day. Raw data: the <code>status-data</code> branch of the public <a href="https://github.com/ROOTSystemss/rootsystems-site/tree/status-data">rootsystems-site repository</a>.</p>
      </div>
    </section>
  </main>
  <%- include("../partials/footer") %>
</body>
</html>
