<!doctype html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
</head>
<body class="page-learn">
  <%- include("../partials/header") %>

  <main>
    <%- include("../partials/page-hero", {
      eyebrow: "Learn",
      title: "Guides and training, <em>in plain English.</em>",
      lead: "Short lessons on what auditors ask for, how proof works, and which standard you actually need. Free, no sign-up."
    }) %>

    <section class="rs-learn">
      <div class="wrap">
        <div class="rs-guide-grid">
          <% guides.forEach(function (g, i) { %>
            <a class="rs-guide reveal rs-guide--<%= ["saffron", "green", "violet"][i % 3] %>" href="/learn/<%= g.slug %>">
              <span class="rs-guide__meta"><%= g.kind %> · <%= g.minutes %> min</span>
              <span class="rs-guide__title"><%= g.title %></span>
              <span class="rs-guide__sum"><%= g.summary %></span>
              <span class="rs-guide__go">Read <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg></span>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  </main>

  <%- include("../partials/footer") %>
  <script src="/js/site.js"></script>
</body>
</html>
