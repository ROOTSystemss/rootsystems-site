<!doctype html>
<html lang="en">
<head><%- include("../partials/head") %></head>
<body class="page-home">
  <%- include("../partials/header") %>
  <main>

    <section class="rs-hero">
      <div class="rs-hero__media" aria-hidden="true">
        <video class="rs-hero__video" autoplay muted loop playsinline preload="metadata" disablepictureinpicture disableremoteplayback tabindex="-1" poster="/images/rootsystems_tree_poster.jpg">
          <source src="/images/rootsystems_tree.mp4" type="video/mp4">
        </video>
      </div>
      <div class="wrap rs-hero__inner">
        <p class="rs-kicker"><span class="rs-kicker__dot"></span>Compliance software that produces evidence</p>
        <h1 class="rs-hero__title">Proof that <em>holds up.</em></h1>
        <p class="rs-hero__lead">When an auditor, a client or a regulator asks <em>“can you prove it?”</em>, RootSystems gives you a report that answers, signed so anyone can check it without trusting us.</p>
        <div class="rs-hero__actions">
          <a class="rs-btn rs-btn--solid" href="/pricing">See plans and pricing</a>
          <a class="rs-btn rs-btn--line" href="#products">Browse the products</a>
        </div>
        <ul class="rs-proofline" aria-label="Security standards">
          <li><strong>ML-DSA-65</strong> post-quantum signatures (NIST FIPS 204)</li>
          <li><strong>SHA-512</strong> fingerprints</li>
          <li><strong>AES-256</strong> encryption at rest</li>
        </ul>
      </div>
    </section>

    <section id="products" class="rs-products">
      <div class="wrap">
        <header class="rs-section-head">
          <p class="rs-eyebrow">Products</p>
          <h2 class="rs-h2">Start with the question<br>you keep being asked.</h2>
        </header>

        <% sections.forEach(function (section, si) { %>
          <div class="rs-floor rs-floor--<%= section.color %>">
            <div class="rs-floor__head">
              <span class="rs-floor__index">0<%= si + 1 %></span>
              <div>
                <h3 class="rs-floor__label"><%= section.label %></h3>
                <p class="rs-floor__lead"><%= section.lead %></p>
              </div>
            </div>
            <ol class="rs-list">
              <% products.filter(function (p) { return p.section === section.slug; }).forEach(function (p) { %>
                <li class="rs-item reveal">
                  <a class="rs-item__link" href="<%= p.href %>">
                    <span class="rs-item__name"><%= p.name %></span>
                    <span class="rs-item__question"><%= p.question %></span>
                    <span class="rs-item__desc"><%= p.description %></span>
                    <span class="rs-item__meta">
                      <span class="rs-tag rs-tag--<%= p.buy %>"><%= p.buy === "self-serve" ? "Start free" : (p.status === "PILOT" ? "Pilot" : (p.status === "SERVICE" ? "Report" : "By invoice")) %></span>
                      <span class="rs-item__price"><%= p.price %></span>
                      <span class="rs-item__go"><%= p.buy === "self-serve" ? "Sign up" : "Talk to us" %> <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg></span>
                    </span>
                  </a>
                </li>
              <% }); %>
            </ol>
          </div>
        <% }); %>
      </div>
    </section>

    <section id="verify" class="rs-verify">
      <div class="wrap rs-verify__grid">
        <div>
          <p class="rs-eyebrow rs-eyebrow--on-dark">How verification works</p>
          <h2 class="rs-h2 rs-h2--on-dark">Don’t take our word for it. Check the signature.</h2>
          <ol class="rs-steps">
            <li><span>1</span><div><strong>Every report is signed.</strong><p>Each report is signed with ML-DSA-65, the post-quantum signature standard NIST published in 2024, and fingerprinted with SHA-512.</p></div></li>
            <li><span>2</span><div><strong>The key is public.</strong><p>Every product publishes its signing key at a fixed address. Anyone can fetch it and check a report, even offline, with our free verifier.</p></div></li>
            <li><span>3</span><div><strong>Change one character and it fails.</strong><p>An edited report no longer matches its signature. It proves the report came from us and is unchanged, today and after quantum computers arrive.</p></div></li>
          </ol>
        </div>
        <figure class="rs-code" aria-label="The live Offboarding Proof signing key">
          <figcaption><span class="rs-code__live"></span>Live now: Offboarding Proof’s published key</figcaption>
<pre><code><span class="c-mute">GET</span> offboarding-proof.onrender.com
    <span class="c-mute">/.well-known/rootsystems-signing-key.json</span>

{
  <span class="c-key">"configured"</span>: <span class="c-val">true</span>,
  <span class="c-key">"algorithm"</span>:  <span class="c-str">"ML-DSA-65"</span>,
  <span class="c-key">"standard"</span>:   <span class="c-str">"NIST FIPS 204"</span>,
  <span class="c-key">"keyId"</span>:      <span class="c-str">"a46b6270385f02a6aa7ee057c8614e2d"</span>,
  <span class="c-key">"publicKey"</span>:  <span class="c-mute">"… 1,952 bytes …"</span>
}</code></pre>
          <a class="rs-code__link" href="https://offboarding-proof.onrender.com/.well-known/rootsystems-signing-key.json" rel="noopener">Open the real key <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg></a>
        </figure>
      </div>
    </section>

    <section class="rs-close">
      <div class="wrap rs-close__inner">
        <img class="rs-close__mark" src="/images/rs-logo.svg" alt="" width="72" height="75">
        <h2 class="rs-h2">Built by one independent studio,<br>to be verified rather than believed.</h2>
        <div class="rs-hero__actions">
          <a class="rs-btn rs-btn--solid" href="/pricing">See plans and pricing</a>
          <a class="rs-btn rs-btn--line-dark" href="/contact">Talk to us</a>
        </div>
      </div>
    </section>

  </main>
  <%- include("../partials/footer") %>
  <script src="/js/site.js"></script>
</body>
</html>
