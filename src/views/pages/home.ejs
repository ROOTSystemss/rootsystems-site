<!doctype html>
<html lang="en">
<head><%- include("../partials/head") %></head>
<body>
  <%- include("../partials/header") %>
  <main>
    <section class="hero hero--home hero--quiet">
      <div class="hero__aurora hero__aurora--one" aria-hidden="true"></div>
      <div class="wrap hero__grid">
        <div class="hero__content">
          <div class="hero__flag"><span class="hero__flag-dot"></span>Independent compliance software studio</div>
          <h1 class="hero__title hero__title--home">Clear tools for accountable work.</h1>
          <p class="hero__subhead">RootSystems builds focused software for access governance, vendor risk, healthcare compliance, and AI governance.</p>
          <div class="hero__actions"><a class="btn btn-primary" href="#products">View the products <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg></a></div>
        </div>

        <figure class="hero-art"><img src="/images/rootsystems-hero-v2.png" alt="Four digital product structures being built around a shared saffron foundation"></figure>
      </div>
    </section>

    <section id="products" class="products section-shell">
      <div class="wrap">
        <div class="section-heading reveal">
          <div><p class="eyebrow">Products</p><h2 class="section-title">Small, focused tools for specific compliance work.</h2></div>
          <p class="section-heading__body">Choose the workspace that matches the job. Each product stays independent and easy to understand.</p>
        </div>

        <div class="product-grid product-grid--simple">
          <% var logos = {
            "Offboarding Proof": "/images/products/offboarding-proof.svg",
            "TPRA — Vendor Risk": "/images/products/tpra.svg",
            "HIPAA Compliance Tool": "/images/products/hipaa.svg",
            "AI Compliance Readiness": "/images/products/ai-readiness.svg"
          }; products.forEach(function (product) { const tag = product.href ? "a" : "article"; %>
            <<%= tag %> class="simple-product simple-product--<%= product.accent %> reveal"<% if(product.href){ %> href="<%= product.href %>"<% } %>>
              <div class="simple-product__top"><img class="simple-product__logo" src="<%= logos[product.name] %>" alt=""><span class="status-tag status-tag--<%= product.status.toLowerCase().replace(/\s+/g, '-') %>"><% if(product.status === "LIVE"){ %><span class="live-dot"></span><% } %><%= product.status %></span></div>
              <span class="simple-product__category"><%= product.category %></span>
              <h3><%= product.name %></h3>
              <p><%= product.description %></p>
              <% if(product.href){ %><span class="simple-product__link">Open product <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg></span><% } %>
            </<%= tag %>>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="standard" class="method-section section-shell">
      <div class="wrap method-section__grid">
        <div><p class="eyebrow">How we build</p><h2 class="section-title">Useful first. Explainable always.</h2><p class="method-section__lead">Our products favor clear workflows and visible logic over broad platforms and mystery scores.</p></div>
        <div class="method-list">
          <div><span>01</span><div><strong>Focused</strong><p>One product solves one recognizable operational problem.</p></div></div>
          <div><span>02</span><div><strong>Understandable</strong><p>Users can follow how an input became a result.</p></div></div>
          <div><span>03</span><div><strong>Evidence-aware</strong><p>Important work can be exported and reviewed later.</p></div></div>
        </div>
      </div>
    </section>

    <section id="about" class="studio-strip">
      <div class="wrap studio-strip__inner reveal">
        <div><p class="eyebrow">RootSystems</p><h2>An independent studio for high-accountability software.</h2></div>
        <p>We build narrow products with practical workflows, direct language, and enough structure to support real operational decisions.</p>
      </div>
    </section>
  </main>
  <%- include("../partials/footer") %>
  <script src="/js/site.js"></script>
</body>
</html>
