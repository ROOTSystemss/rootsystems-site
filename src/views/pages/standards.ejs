<!doctype html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
</head>
<body class="page-standards">
  <%- include("../partials/header") %>

  <main>
    <%- include("../partials/page-hero", {
      eyebrow: "Standards Readiness",
      title: "Twelve standards. <em>One way to prove them.</em>",
      lead: "The same readiness check, evidence fingerprints and signed report for every standard. Pick only the standards you need, and your first assessment is free."
    }) %>

    <section class="rs-standards">
      <div class="wrap">
        <% standards.groups.forEach(function (g, gi) { %>
          <div class="rs-floor rs-floor--<%= g.color %>">
            <div class="rs-floor__head">
              <span class="rs-floor__index">0<%= gi + 1 %></span>
              <div>
                <h2 class="rs-floor__label"><%= g.label %></h2>
                <p class="rs-floor__lead"><%= g.lead %></p>
              </div>
            </div>
            <div class="rs-std-grid">
              <% standards.standards.filter(function (s) { return s.group === g.slug; }).forEach(function (s) { %>
                <article id="<%= s.id %>" class="rs-std reveal">
                  <header class="rs-std__head">
                    <h3 class="rs-std__name"><%= s.name %></h3>
                  </header>
                  <dl class="rs-std__facts">
                    <dt>Who needs it</dt><dd><%= s.who %></dd>
                    <dt>What we check</dt><dd><%= s.checks %></dd>
                  </dl>
                  <footer class="rs-std__foot">
                    <a class="rs-std__go" href="<%= s.href %>">Start this check <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg></a>
                    <a class="rs-std__src" href="<%= s.source.url %>" target="_blank" rel="noopener noreferrer">Official source: <%= s.source.label %></a>
                  </footer>
                </article>
              <% }); %>
            </div>
          </div>
        <% }); %>

        <div class="rs-bundle reveal">
          <div>
            <p class="rs-eyebrow rs-eyebrow--on-dark">Every standard</p>
            <p class="rs-bundle__title">All 12 standards in <span>one workspace</span></p>
            <p class="rs-bundle__lead">Every check, every signed report. Pay per standard or take them all; the plans are on the <a href="/pricing#compliance-readiness">pricing page</a>. HIPAA has its own tool, the <a href="/pricing#hipaa">HIPAA Compliance Tool</a>.</p>
          </div>
          <div class="rs-hero__actions">
            <a class="rs-btn rs-btn--solid" href="<%= standards.signupHref %>">Start free</a>
            <a class="rs-btn rs-btn--line" href="/pricing#compliance-readiness">See pricing</a>
          </div>
        </div>

        <p class="rs-note">Readiness checks, not certifications. Only a licensed CPA firm can issue a SOC 2 report, only an accredited body can certify ISO 27001 or ISO 42001, and only an authorized assessor can grant CMMC certification. <a href="/learn/readiness-vs-certification">Why a readiness check still matters</a>.</p>
      </div>
    </section>
  </main>

  <%- include("../partials/footer") %>
  <script src="/js/site.js"></script>
</body>
</html>
