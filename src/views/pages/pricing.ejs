<!doctype html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
</head>
<body class="page-pricing">
  <%- include("../partials/header") %>

  <main>
    <%- include("../partials/page-hero", {
      eyebrow: "Pricing",
      title: "Pay for the proof <em>you need.</em>",
      lead: "Every product is priced on its own and starts free. Monthly plans, cancel any time, and subscription payments run through Dodo Payments, so we never see your card.",
      noVideo: true
    }) %>

    <nav class="rs-jump" aria-label="Jump to a product">
      <div class="wrap rs-jump__inner">
        <% tools.forEach(function (tool) { %><a class="rs-jump__link" href="#<%= tool.slug %>"><%= tool.name %></a><% }); %>
        <a class="rs-jump__link" href="#by-invoice">PQC Forge</a>
        <a class="rs-jump__link" href="#bundles">Bundles</a>
        <a class="rs-jump__link" href="#proof-plus">Proof+</a>
      </div>
    </nav>

    <section class="rs-plans">
      <div class="wrap rs-plans__wrap">
        <% var accents = { "offboarding-proof": "saffron", "tpra": "saffron", "hipaa": "saffron", "compliance-readiness": "saffron", "agent-governance": "violet" }; %>
        <% tools.forEach(function (tool) { %>
          <article id="<%= tool.slug %>" class="rs-plan rs-plan--<%= accents[tool.slug] || "saffron" %> reveal">
            <header class="rs-plan__head">
              <h2 class="rs-plan__name"><%= tool.name %></h2>
              <p class="rs-plan__blurb"><%= tool.blurb %></p>
            </header>

            <% if (tool.tiers) { %>
              <div class="rs-plan__tiers">
                <% tool.tiers.forEach(function (tier, i) { %>
                  <div class="rs-tier<%= i === 1 ? " rs-tier--lit" : "" %>">
                    <p class="rs-tier__name"><%= tier.name %></p>
                    <p class="rs-tier__price"><span class="rs-tier__cur">$</span><%= tier.price %><span class="rs-tier__per">/<%= tier.period %></span></p>
                    <p class="rs-tier__note"><%= tier.note %></p>
                  </div>
                <% }); %>
              </div>
            <% } else if (tool.contactOnly) { %>
              <div class="rs-plan__tiers rs-plan__tiers--one">
                <div class="rs-tier rs-tier--lit">
                  <p class="rs-tier__name">Early access</p>
                  <p class="rs-tier__price">Contact us</p>
                  <p class="rs-tier__note">Currently onboarding pilot customers. Reach out to discuss your use case.</p>
                </div>
              </div>
            <% } %>

            <% if (tool.slug === "compliance-readiness") { %>
              <div class="rs-plan__standards">
                <p class="rs-plan__sub">Each standard is its own plan</p>
                <ul class="rs-chips">
                  <% standards.standards.forEach(function (s) { %>
                    <li><a class="rs-chip" href="/standards#<%= s.id %>"><%= s.name %> <span>$<%= s.price %></span></a></li>
                  <% }); %>
                </ul>
                <p class="rs-plan__fine">Or all 12 standards for $<%= standards.BUNDLE_USD %>/mo. Your first assessment is free on any standard.</p>
              </div>
            <% } %>

            <div class="rs-plan__foot">
              <% if (tool.contactOnly) { %>
                <a class="rs-btn rs-btn--line" href="<%= tool.href %>">Contact for early access</a>
              <% } else { %>
                <a class="rs-btn rs-btn--solid" href="<%= tool.href %>">Start free</a>
              <% } %>
              <% if (tool.slug === "compliance-readiness") { %><a class="rs-btn rs-btn--line" href="/standards">See all 12 standards</a><% } %>
            </div>
          </article>
        <% }); %>

        <article id="by-invoice" class="rs-plan rs-plan--green reveal">
          <header class="rs-plan__head">
            <h2 class="rs-plan__name">PQC Forge</h2>
            <p class="rs-plan__blurb">Finds the RSA and elliptic-curve cryptography a quantum computer will break, proposes the patch, and signs the evidence. Today it is delivered as a readiness report.</p>
          </header>
          <div class="rs-plan__tiers rs-plan__tiers--one">
            <div class="rs-tier rs-tier--lit">
              <p class="rs-tier__name">Readiness report</p>
              <p class="rs-tier__price"><span class="rs-tier__cur">$</span>2,500<span class="rs-tier__per"> once</span></p>
              <p class="rs-tier__note">We scan your repositories and servers and hand over a signed report. <%= pqcReportBuyHref ? "Pay online or by invoice." : "Invoiced." %></p>
            </div>
          </div>
          <div class="rs-plan__foot">
            <% if (pqcReportBuyHref) { %><a class="rs-btn rs-btn--solid" href="<%= pqcReportBuyHref %>" rel="noopener">Buy the report</a><% } %>
            <a class="rs-btn rs-btn--line" href="/contact?topic=<%= encodeURIComponent('PQC Forge readiness report') %>">Talk to us</a>
          </div>
          <p class="rs-plan__fine rs-plan__fine--pad">
            <% if (pqcForgeAppHref) { %>
              Prefer to run it yourself? <a href="<%= pqcForgeAppHref %>" rel="noopener">Open the PQC Forge app</a>: free for public repositories, with paid plans for private ones shown in the app.
            <% } else { %>
              A self-serve PQC Forge app is in early access. <a href="/contact?topic=<%= encodeURIComponent('PQC Forge app early access') %>">Ask to join</a>.
            <% } %>
          </p>
        </article>

        <article id="bundles" class="rs-plan rs-plan--saffron rs-plan--wide reveal">
          <header class="rs-plan__head">
            <h2 class="rs-plan__name">Bundles</h2>
            <p class="rs-plan__blurb">Several products on one bill and one contact. Each card shows what the parts cost separately today; tell us which one fits and we will send the bundle price.</p>
          </header>
          <div class="rs-plan__tiers rs-bundles">
            <% bundles.concat([everything]).forEach(function (b) { %>
              <div class="rs-tier<%= b.slug === "clinic-proof-pack" ? " rs-tier--lit" : "" %>" id="<%= b.slug %>">
                <p class="rs-tier__name"><%= b.name %></p>
                <p class="rs-tier__note"><%= b.blurb %></p>
                <ul class="rs-bundle__list">
                  <% b.includes.forEach(function (item) { %><li><%= item %></li><% }); %>
                </ul>
                <p class="rs-tier__note"><strong>$<%= b.separately %>/mo</strong> separately</p>
                <a class="rs-btn rs-btn--line" href="<%= b.href %>">Ask for the bundle price</a>
              </div>
            <% }); %>
          </div>
        </article>

        <article id="<%= partner.slug %>" class="rs-plan rs-plan--green reveal">
          <header class="rs-plan__head">
            <h2 class="rs-plan__name"><%= partner.name %></h2>
            <p class="rs-plan__blurb"><%= partner.blurb %></p>
          </header>
          <div class="rs-plan__tiers rs-plan__tiers--one">
            <div class="rs-tier rs-tier--lit">
              <p class="rs-tier__name">For IT providers</p>
              <p class="rs-tier__price">By quote</p>
              <ul class="rs-bundle__list">
                <% partner.includes.forEach(function (item) { %><li><%= item %></li><% }); %>
              </ul>
            </div>
          </div>
          <div class="rs-plan__foot"><a class="rs-btn rs-btn--line" href="<%= partner.href %>">Talk to us</a></div>
        </article>

        <article id="<%= proofPlus.slug %>" class="rs-plan rs-plan--violet rs-plan--wide reveal">
          <header class="rs-plan__head">
            <h2 class="rs-plan__name"><%= proofPlus.name %></h2>
            <p class="rs-plan__blurb"><%= proofPlus.blurb %></p>
          </header>
          <div class="rs-plan__tiers rs-bundles">
            <% proofPlus.features.forEach(function (f) { %>
              <div class="rs-tier">
                <p class="rs-tier__name"><%= f.title %></p>
                <p class="rs-tier__note"><%= f.text %></p>
              </div>
            <% }); %>
          </div>
          <div class="rs-plan__foot">
            <p class="rs-tier__price"><span class="rs-tier__per">from </span><span class="rs-tier__cur">$</span><%= proofPlus.from %><span class="rs-tier__per">/mo, by quote</span></p>
            <a class="rs-btn rs-btn--solid" href="<%= proofPlus.href %>">Talk to us</a>
          </div>
        </article>

        <article id="toolkits" class="rs-plan rs-plan--saffron reveal">
          <header class="rs-plan__head">
            <h2 class="rs-plan__name">Toolkits</h2>
            <p class="rs-plan__blurb">An Excel workbook and Word handbook per framework or programme, with the requirements already filled in. No subscription.</p>
          </header>
          <div class="rs-plan__tiers">
            <div class="rs-tier">
              <p class="rs-tier__name">One toolkit</p>
              <p class="rs-tier__price"><span class="rs-tier__cur">$</span><%= toolkitPrices.single %><span class="rs-tier__per"> once</span></p>
              <p class="rs-tier__note">HIPAA, SOC 2, ISO 27001, GDPR, PCI DSS, AI Governance and five programme toolkits.</p>
            </div>
            <div class="rs-tier rs-tier--lit">
              <p class="rs-tier__name">All 11</p>
              <p class="rs-tier__price"><span class="rs-tier__cur">$</span><%= toolkitPrices.bundle %><span class="rs-tier__per"> once</span></p>
              <p class="rs-tier__note">Every toolkit, for consultants and teams running several frameworks.</p>
            </div>
          </div>
          <div class="rs-plan__foot"><a class="rs-btn rs-btn--line" href="/toolkits">See the toolkits</a></div>
        </article>
      </div>
    </section>

    <section class="rs-faq">
      <div class="wrap rs-faq__grid">
        <div>
          <p class="rs-eyebrow">Good to know</p>
          <h2 class="rs-h2">Straight answers about paying us.</h2>
        </div>
        <dl class="rs-faq__list">
          <div><dt>Who handles payment?</dt><dd>For subscriptions, Dodo Payments is the merchant of record. It takes the payment and handles sales tax, and we never see or store card numbers.</dd></div>
          <div><dt>Can I cancel?</dt><dd>Yes, any time: email hello@rootsystems.app from your account address and we confirm by reply. You keep access until the end of the period you paid for. See the <a href="/refund">refund policy</a>.</dd></div>
          <div><dt>What does free include?</dt><dd>Each product has a free start: a small number of employees, five vendor assessments, one assessment or a two-agent trial, so you can see a real signed report before paying.</dd></div>
          <div><dt>Is my data safe when I sign up?</dt><dd>Each workspace is separate, passwords are stored only as hashes, and sensitive data is encrypted at rest. Read the <a href="/security">security page</a>.</dd></div>
        </dl>
      </div>
    </section>
  </main>

  <%- include("../partials/footer") %>
  <script src="/js/site.js"></script>
</body>
</html>
