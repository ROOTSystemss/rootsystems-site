<%# Inner-page hero: same ink, serif and glowing tree as the home page, at a smaller scale.
    Params: eyebrow, title (may contain <em>), lead (optional), compact (optional), noVideo (optional: hide the tree). %>
<section class="rs-page-hero<%= typeof compact !== "undefined" && compact ? " rs-page-hero--compact" : "" %>">
  <% if (typeof noVideo === "undefined" || !noVideo) { %>
  <div class="rs-page-hero__media" aria-hidden="true">
    <picture>
      <source srcset="/images/rootsystems-tree-hero.webp" type="image/webp">
      <img class="rs-page-hero__img" src="/images/rootsystems-tree-hero.jpg" alt="" width="1280" height="668" decoding="async">
    </picture>
  </div>
  <% } %>
  <div class="wrap rs-page-hero__inner">
    <p class="rs-kicker"><span class="rs-kicker__dot"></span><%= eyebrow %></p>
    <h1 class="rs-page-hero__title"><%- title %></h1>
    <% if (typeof lead !== "undefined" && lead) { %><p class="rs-hero__lead rs-page-hero__lead"><%- lead %></p><% } %>
  </div>
</section>
