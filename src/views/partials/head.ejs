<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %></title>
<meta
  name="description"
  content="RootSystems builds focused compliance and security products that turn operational work into clear, verifiable evidence."
/>
<meta name="theme-color" content="#071735" />
<meta name="color-scheme" content="light dark" />
<script>
  // Applies the saved/preferred theme before first paint, so there is no
  // flash of the wrong theme. Kept inline (not in site.js) specifically so
  // it runs synchronously ahead of CSS/paint rather than after DOMContentLoaded.
  (function () {
    try {
      var saved = localStorage.getItem("rs-theme");
      if (saved === "dark" || saved === "light") {
        document.documentElement.setAttribute("data-theme", saved);
      }
    } catch (e) {}
  })();
</script>
<%# Favicon: the RootSystems tree mark on orange (public/images/favicon-*.png). %>
