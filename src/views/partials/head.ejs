<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %></title>
<meta
  name="description"
  content="RootSystems builds focused compliance and security products that turn operational work into clear, verifiable evidence."
/>
<meta name="theme-color" content="#070a12" />
<meta name="color-scheme" content="light" />
<script>
  // One designed look: the site no longer has a dark/light switch. Pinning
  // data-theme="light" before first paint keeps the old dark-scheme CSS rules
  // (guarded by :root:not([data-theme="light"])) from applying, including for
  // visitors who saved "dark" with the old toggle.
  document.documentElement.setAttribute("data-theme", "light");
  try { localStorage.removeItem("rs-theme"); } catch (e) {}
</script>
<%# Favicon: the RootSystems tree mark on orange (public/images/favicon-*.png). %>
<link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
  rel="stylesheet"
/>
