<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand">
      <img
        class="brand__mark"
        src="/images/rs-mark-orange.png"
        alt="RootSystems"
        onerror="this.style.display='none'"
      />
      <span class="brand__lockup">
        <span class="brand__word">RootSystems</span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
      <a class="site-nav__link" href="/#products">Products</a>
      <a class="site-nav__link" href="/#standard">Approach</a>
      <%# Future nav entries slot in here as their pages ship, e.g.: %>
      <%# <a class="site-nav__link" href="/blog">Blog</a> %>
      <a class="site-nav__cta" href="/contact">
        Contact
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg>
      </a>
    </nav>

    <div class="site-header__controls">
      <button type="button" class="theme-toggle" aria-label="Switch to dark theme">
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8"/></svg>
      </button>

      <button
        type="button"
        class="site-nav__toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <span class="site-nav__toggle-bar"></span>
        <span class="site-nav__toggle-bar"></span>
        <span class="site-nav__toggle-bar"></span>
      </button>
    </div>
  </div>
</header>
